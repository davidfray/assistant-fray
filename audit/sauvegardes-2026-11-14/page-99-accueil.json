{"id":99,"date":"2026-07-22T08:57:54","date_gmt":"2026-07-22T08:57:54","guid":{"rendered":"https:\/\/www.solandvolt.com\/?page_id=99","raw":"https:\/\/www.solandvolt.com\/?page_id=99"},"modified":"2026-11-12T10:46:48","modified_gmt":"2026-11-12T10:46:48","password":"","slug":"accueil-nouvelle-version","status":"publish","type":"page","link":"https:\/\/www.solandvolt.com\/","title":{"raw":"Solandvolt","rendered":"Solandvolt"},"content":{"raw":"<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#3D2E0A\"},\"spacing\":{\"padding\":{\"top\":\"64px\",\"bottom\":\"56px\",\"left\":\"24px\",\"right\":\"24px\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"640px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#3D2E0A;margin-top:0;margin-bottom:0;padding-top:64px;padding-right:24px;padding-bottom:56px;padding-left:24px\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"13px\",\"letterSpacing\":\"0.08em\",\"textTransform\":\"uppercase\",\"fontWeight\":\"600\",\"textAlign\":\"center\"},\"color\":{\"text\":\"#D98E2B\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#D98E2B;font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase\">Autonomie \u00e9nerg\u00e9tique solaire<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:heading {\"level\":1,\"className\":\"has-text-align-center\",\"style\":{\"color\":{\"text\":\"#F7F3EC\"},\"typography\":{\"fontSize\":\"36px\",\"lineHeight\":\"1.25\"}}} -->\n<h1 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#F7F3EC;font-size:36px;line-height:1.25\">Kits solaires et batteries pour l\u2019autonomie \u00e9nerg\u00e9tique<\/h1>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#F7F3EC\"},\"typography\":{\"fontSize\":\"22px\",\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#F7F3EC;font-size:22px\">Le jour o\u00f9 le courant saute, vous continuez \u00e0 vivre normalement<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#B7C0C2\"},\"typography\":{\"fontSize\":\"16px\",\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#B7C0C2;font-size:16px\">Kits solaires, batteries et stations portables pour pr\u00e9parer votre foyer aux coupures, sans travaux, \u00e0 votre rythme.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"color\":{\"background\":\"#D98E2B\",\"text\":\"#1F2A2E\"},\"border\":{\"radius\":\"6px\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-color has-background wp-element-button\" href=\"\/boutique\/\" style=\"border-radius:6px;color:#1F2A2E;background-color:#D98E2B\">Voir la boutique<\/a><\/div>\n<!-- \/wp:button -->\n\n<!-- wp:button {\"style\":{\"color\":{\"background\":\"transparent\"},\"border\":{\"radius\":\"6px\",\"width\":\"1px\",\"color\":\"#4A5659\"}}} -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-background has-border-color wp-element-button\" href=\"#niveaux\" style=\"border-color:#4A5659;border-width:1px;border-radius:6px;background-color:transparent\">D\u00e9couvrir les 4 niveaux d\u2019autonomie<\/a><\/div>\n<!-- \/wp:button --><\/div>\n<!-- \/wp:buttons --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"56px\",\"right\":\"24px\",\"bottom\":\"56px\",\"left\":\"24px\"}}},\"anchor\":\"niveaux\"} -->\n<div class=\"wp-block-group alignfull\" id=\"niveaux\" style=\"padding-top:56px;padding-right:24px;padding-bottom:56px;padding-left:24px\"><!-- wp:heading {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center\">L\u2019autonomie par niveaux<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\">Une progression, pas un bunker. Chaque niveau est une brique vers la souverainet\u00e9 \u00e9nerg\u00e9tique.<\/p>\n<!-- \/wp:paragraph -->\n\n<!-- wp:html -->\n<div class=\"solandvolt-grid\">\n  <div class=\"solandvolt-card\">\n    <div class=\"card-badge\">Niveau 01<\/div>\n    <h3>La Veilleuse<\/h3>\n    <p class=\"card-subtitle\">Une lampe, un chargeur, une petite batterie. De quoi passer une soir\u00e9e sans courant.<\/p>\n    <ul class=\"card-specs\"><li>\u00c9clairage LED<\/li><li>Chargeur<\/li><li>Petite batterie<\/li><\/ul>\n    <div class=\"card-duration\">Autonomie : quelques heures<\/div>\n    <a href=\"\/categorie-produit\/autonomie-energetique\/la-veilleuse\/\" class=\"card-btn wp-element-button\">D\u00e9couvrir \u2192<\/a>\n  <\/div>\n  <div class=\"solandvolt-card\">\n    <div class=\"card-badge\">Niveau 02<\/div>\n    <h3>Le Module<\/h3>\n    <p class=\"card-subtitle\">Station portable, panneau solaire. La box, la lumi\u00e8re et les t\u00e9l\u00e9phones, d\u2019une soir\u00e9e \u00e0 une journ\u00e9e.<\/p>\n    <ul class=\"card-specs\"><li>Station portable<\/li><li>Panneau solaire<\/li><li>Box, \u00e9clairage, chargeurs<\/li><\/ul>\n    <div class=\"card-duration\">Autonomie : une soir\u00e9e \u00e0 une journ\u00e9e<\/div>\n    <a href=\"\/categorie-produit\/autonomie-energetique\/le-module\/\" class=\"card-btn wp-element-button\">D\u00e9couvrir \u2192<\/a>\n  <\/div>\n  <div class=\"solandvolt-card featured\">\n    <div class=\"card-badge\">Niveau 03<\/div>\n    <h3>La Base<\/h3>\n    <p class=\"card-subtitle\">Station de forte capacit\u00e9 et panneaux solaires. Le r\u00e9frig\u00e9rateur en marche, une journ\u00e9e et plus avec le soleil.<\/p>\n    <ul class=\"card-specs\"><li>Station de forte capacit\u00e9<\/li><li>Panneaux solaires<\/li><li>R\u00e9frig\u00e9rateur<\/li><\/ul>\n    <div class=\"card-duration\">Autonomie : une journ\u00e9e et plus<\/div>\n    <a href=\"\/categorie-produit\/autonomie-energetique\/la-base\/\" class=\"card-btn wp-element-button\">D\u00e9couvrir \u2192<\/a>\n  <\/div>\n  <div class=\"solandvolt-card\">\n    <div class=\"card-badge\">Niveau 04<\/div>\n    <h3>L\u2019Autonomie<\/h3>\n    <p class=\"card-subtitle\">La maison produit et stocke une partie de son \u00e9nergie, chaque jour. Moins de d\u00e9pendance au r\u00e9seau.<\/p>\n    <ul class=\"card-specs\"><li>Production solaire<\/li><li>Stockage domestique<\/li><li>Moins de r\u00e9seau<\/li><\/ul>\n    <div class=\"card-duration\">Autonomie : au quotidien, selon le soleil<\/div>\n    <a href=\"\/categorie-produit\/lautonomie\/\" class=\"card-btn wp-element-button\">D\u00e9couvrir \u2192<\/a>\n  <\/div>\n<\/div>\n<!-- \/wp:html --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#FFFFFF\"},\"spacing\":{\"padding\":{\"top\":\"56px\",\"bottom\":\"56px\",\"left\":\"24px\",\"right\":\"24px\"}},\"border\":{\"top\":{\"color\":\"#E6DFCF\",\"width\":\"1px\"},\"bottom\":{\"color\":\"#E6DFCF\",\"width\":\"1px\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"1100px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"border-top-color:#E6DFCF;border-top-width:1px;border-bottom-color:#E6DFCF;border-bottom-width:1px;background-color:#FFFFFF;padding-top:56px;padding-right:24px;padding-bottom:56px;padding-left:24px\"><!-- wp:heading {\"className\":\"has-text-align-center\",\"style\":{\"color\":{\"text\":\"#1F2A2E\"},\"typography\":{\"fontSize\":\"24px\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center has-text-color\" style=\"color:#1F2A2E;font-size:24px\">Nos stations les plus demand\u00e9es<\/h2>\n<!-- \/wp:heading -->\n\n<!-- wp:shortcode -->\n[products ids=\"623,344,346\" columns=\"3\"]\n<!-- \/wp:shortcode --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#F7F3EC\"},\"spacing\":{\"padding\":{\"top\":\"40px\",\"bottom\":\"40px\",\"left\":\"24px\",\"right\":\"24px\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"900px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"background-color:#F7F3EC;padding-top:40px;padding-right:24px;padding-bottom:40px;padding-left:24px\"><!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"20px\"}}}} -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"13px\",\"textAlign\":\"center\"},\"color\":{\"text\":\"#5F6A6C\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#5F6A6C;font-size:13px\">Livraison France et Espagne<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"13px\",\"textAlign\":\"center\"},\"color\":{\"text\":\"#5F6A6C\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#5F6A6C;font-size:13px\">Service client bilingue fran\u00e7ais \/ espagnol<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"13px\",\"textAlign\":\"center\"},\"color\":{\"text\":\"#5F6A6C\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#5F6A6C;font-size:13px\">Sourcing rigoureux, fournisseurs v\u00e9rifi\u00e9s<\/p>\n<!-- \/wp:paragraph --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns --><\/div>\n<!-- \/wp:group -->\n\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#14201C\"},\"spacing\":{\"padding\":{\"top\":\"48px\",\"bottom\":\"48px\",\"left\":\"24px\",\"right\":\"24px\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"640px\"}} -->\n<div class=\"wp-block-group alignfull has-background\" style=\"backgro